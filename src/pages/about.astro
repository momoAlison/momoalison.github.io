---
import BaseLayout from '../layouts/BaseLayout.astro';
import InlineSvg from '../components/InlineSvg.astro';
import { site } from '../data/site';
import { withBase } from '../lib/urls';
import { experience } from '../data/work';
---
<BaseLayout title="About" description={site.about.introduction}>
  <div class="about-page">
    <header class="about-hero">
      <div class="about-intro"><p class="eyebrow">About</p><h1>{site.about.title}</h1><p>{site.about.introduction}</p></div>
      <div class="character about-character" id="about-character" aria-hidden="true"><InlineSvg src="/images/sayhi.svg" /></div>
    </header>

    <section class="about-path" aria-labelledby="about-path-heading">
      <p class="eyebrow" id="about-path-heading">My path</p>
      <ol class="path-steps">
        {site.about.path.map((step) => <li class="path-step"><p class="path-step-label">{step.label}</p><p class="path-step-description">{step.description}</p></li>)}
      </ol>
    </section>

    <section class="about-interests" aria-labelledby="about-interests-heading">
      <p class="eyebrow" id="about-interests-heading">Currently interested in</p>
      <ul class="interest-pills">{site.about.interests.map((interest) => <li>{interest}</li>)}</ul>
    </section>

    <section class="about-background" aria-labelledby="about-background-heading">
      <div class="about-section-head">
        <p class="eyebrow" id="about-background-heading">Background</p>
        <button type="button" class="about-more" id="about-more-toggle" aria-expanded="false" aria-controls="about-timeline">
          <span class="about-more-closed">More <span aria-hidden="true">↓</span></span>
          <span class="about-more-open">Less <span aria-hidden="true">↑</span></span>
        </button>
      </div>
      <ul class="background-items">{site.about.background.map((item) => <li><p class="background-label">{item.label}</p><p class="background-detail">{item.detail}</p></li>)}</ul>
    </section>

    <div class="about-timeline" id="about-timeline">
      <p class="eyebrow">Work Experience</p>
      <ol class="timeline">
        {experience.map((item) => (
          <li class="timeline-item">
            <p class="timeline-year">{item.yearLabel}</p>
            <div class="timeline-marker"><span class="timeline-dot" aria-hidden="true"></span></div>
            <div class="timeline-body">
              <p class="timeline-org">{item.org}</p>
              <p class="timeline-role">{item.role}</p>
              <p class="timeline-description">{item.project && <strong>{item.project}</strong>}{item.project ? ' — ' : ''}{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <footer class="about-footer">
      <div class="about-footer-links">
        <a class="text-link" href={withBase('blog/')}>Explore the notebook <span aria-hidden="true">→</span></a>
        <a class="text-link" href={site.about.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
        <a class="text-link" href={site.about.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      </div>
      <p class="about-closing">{site.about.closing}</p>
    </footer>

    <script>
      // Progressive enhancement only: the timeline renders fully visible by
      // default (real content, no JS required to read it). JS collapses it
      // behind the "More" toggle and, once expanded, drives a single
      // "how many nodes are active" count that both the scroll position and
      // a hover/focus preview can set — whichever is active wins, so there's
      // one rendering path rather than two competing systems. A passive
      // rAF-throttled scroll listener is used instead of
      // IntersectionObserver, matching the article TOC scrollspy elsewhere
      // on the site. Scoped to this page only.
      const toggle = document.getElementById('about-more-toggle');
      const panel = document.getElementById('about-timeline');
      if (toggle && panel) {
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');

        const items = Array.from(panel.querySelectorAll<HTMLElement>('.timeline-item'));
        let scrollCount = 0;
        // Non-null while hovering/focusing a node: temporarily overrides
        // scrollCount so the line previews exactly up to that node.
        let previewCount: number | null = null;

        const render = () => {
          const activeCount = previewCount !== null ? previewCount : scrollCount;
          items.forEach((item, index) => item.classList.toggle('is-reached', index < activeCount));
        };

        let ticking = false;
        const updateScrollCount = () => {
          ticking = false;
          const readLine = window.innerHeight * 0.3;
          scrollCount = items.filter((item) => {
            const dot = item.querySelector('.timeline-dot');
            return dot ? dot.getBoundingClientRect().top <= readLine : false;
          }).length;
          render();
        };
        window.addEventListener(
          'scroll',
          () => {
            if (panel.hidden || ticking) return;
            ticking = true;
            requestAnimationFrame(updateScrollCount);
          },
          { passive: true },
        );

        // Touch devices report no real pointer hover; skip mouse listeners
        // there so a tap can't leave the preview stuck with no matching
        // pointerleave, and scrolling stays the only driver on touch.
        const supportsHover = window.matchMedia('(hover: hover)').matches;
        items.forEach((item, index) => {
          const preview = () => {
            previewCount = index + 1;
            render();
          };
          const clearPreview = () => {
            previewCount = null;
            render();
          };
          if (supportsHover) {
            item.addEventListener('mouseenter', preview);
            item.addEventListener('mouseleave', clearPreview);
          }
          item.tabIndex = 0;
          item.addEventListener('focus', preview);
          item.addEventListener('blur', clearPreview);
        });

        toggle.addEventListener('click', () => {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          panel.hidden = expanded;
          if (!panel.hidden) updateScrollCount();
        });
      }

      // CSS handles the one-shot greeting. Ignore clicks during a wave;
      // no forced layout, animation queue, or per-frame JavaScript.
      const character = document.getElementById('about-character');
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (character) {
        let waveTimeout: ReturnType<typeof setTimeout> | undefined;
        const stopWave = () => {
          clearTimeout(waveTimeout);
          character.classList.remove('is-waving');
        };
        const playWave = () => {
          if (motionPreference.matches || character.classList.contains('is-waving')) return;
          character.classList.add('is-waving');
          waveTimeout = setTimeout(stopWave, 1700);
        };
        motionPreference.addEventListener('change', stopWave);
        character.addEventListener('click', playWave);
        playWave();
      }
    </script>
  </div>
</BaseLayout>
