---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import InlineSvg from '../components/InlineSvg.astro';
import { site } from '../data/site';
import { getPublishedPosts } from '../lib/blog';
import { withBase } from '../lib/urls';
const posts = (await getPublishedPosts()).slice(0, 3);
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{site.eyebrow}</p>
      <h1 id="hero-title">{site.heroTitle}</h1>
      <p class="hero-description">{site.heroDescription}</p>
      <div class="hero-links"><a class="button" href={withBase('blog/')}>Read the blog <span aria-hidden="true">→</span></a><a class="text-link" href={withBase('about/')}>A little about me <span aria-hidden="true">↗</span></a></div>
      <p class="hero-footnote">Software. Curiosity. Things worth making.</p>
    </div>
    <div class="character home-character" id="home-character"><InlineSvg src="/images/character.svg" /></div>
  </section>
  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Latest writing</h2><a class="text-link" href={withBase('blog/')}>All writing <span aria-hidden="true">→</span></a></div>
    {posts.length ? <PostList posts={posts} /> : <div class="empty-state"><p class="eyebrow">A fresh page</p><h3>Good ideas start with a note.</h3><p>Notes and essays will find a home here soon.</p></div>}
  </section>
  <section class="about-transition" aria-labelledby="about-title"><div><p class="eyebrow">Behind the screen</p><h2 id="about-title">Always something to learn.<br />Always something to build.</h2></div><a class="text-link" href={withBase('about/')}>More about this space <span aria-hidden="true">→</span></a></section>
  <script>
    // Ambient eye-tracking only: a very small, eased offset toward the
    // pointer. Hair sway is pure CSS (see global.css) and needs no JS.
    // Skipped entirely on touch/coarse pointers and under
    // prefers-reduced-motion, per the site's progressive-enhancement rule —
    // the illustration always renders fully formed without this script.
    const character = document.getElementById('home-character');
    const eyeLeft = character?.querySelector<HTMLElement>('[data-eye-left]');
    const eyeRight = character?.querySelector<HTMLElement>('[data-eye-right]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const supportsFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (character && eyeLeft && eyeRight && !reduceMotion && supportsFinePointer) {
      const MAX_OFFSET = 6; // SVG user units (~2-3 rendered px at typical hero size) — a small, charming glance
      const REACH = 420; // px from center at which the offset reaches its max
      const EASE = 0.18;
      const SETTLE_EPSILON = 0.01;

      let lastX: number | null = null;
      let lastY: number | null = null;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let rafId: number | null = null;

      const applyOffset = () => {
        const x = `${currentX.toFixed(2)}px`;
        const y = `${currentY.toFixed(2)}px`;
        eyeLeft.style.setProperty('--eye-x', x);
        eyeLeft.style.setProperty('--eye-y', y);
        eyeRight.style.setProperty('--eye-x', x);
        eyeRight.style.setProperty('--eye-y', y);
      };

      const step = () => {
        rafId = null;
        if (lastX !== null && lastY !== null) {
          // Read layout once per animation frame, never per raw pointer event.
          const rect = character.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = lastX - cx;
          const dy = lastY - cy;
          const dist = Math.hypot(dx, dy) || 1;
          const norm = Math.min(1, dist / REACH);
          targetX = (dx / dist) * MAX_OFFSET * norm;
          targetY = (dy / dist) * MAX_OFFSET * norm;
        } else {
          targetX = 0;
          targetY = 0;
        }
        currentX += (targetX - currentX) * EASE;
        currentY += (targetY - currentY) * EASE;
        applyOffset();
        const settled = Math.abs(targetX - currentX) < SETTLE_EPSILON && Math.abs(targetY - currentY) < SETTLE_EPSILON;
        if (!settled) rafId = requestAnimationFrame(step);
      };

      const requestStep = () => {
        if (rafId === null) rafId = requestAnimationFrame(step);
      };

      window.addEventListener('pointermove', (event) => {
        lastX = event.clientX;
        lastY = event.clientY;
        requestStep();
      }, { passive: true });

      window.addEventListener('pointerleave', () => {
        lastX = null;
        lastY = null;
        requestStep();
      }, { passive: true });
    }
  </script>
</BaseLayout>
