---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArticleToc from '../components/ArticleToc.astro';
import CopyButtonScript from '../components/CopyButtonScript.astro';
import BackToTop from '../components/BackToTop.astro';
import { withBase } from '../lib/urls';
interface Props { frontmatter: { title: string; description: string }; headings: MarkdownHeading[]; }
const { frontmatter, headings } = Astro.props;
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} noindex>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">Internal guide</p>
      <h1>{frontmatter.title}</h1>
      <p class="article-description">{frontmatter.description}</p>
    </header>
    <div class:list={['article-grid', { 'has-toc': toc.length > 1 }]}>
      <ArticleToc headings={headings} />
      <div class="prose"><slot /></div>
    </div>
    <footer class="article-footer"><a class="text-link" href={withBase('')}><span aria-hidden="true">←</span> Back home</a></footer>
  </article>
  <CopyButtonScript />
  <BackToTop />
</BaseLayout>
