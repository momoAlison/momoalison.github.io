---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { collectionLabels, formatDate } from '../lib/blog';
import { withBase } from '../lib/urls';
interface Props { post: CollectionEntry<'blog'>; headings: MarkdownHeading[]; }
const { post, headings } = Astro.props;
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article-page">
    <header class="article-header"><a class="text-link back-link" href={withBase('blog/')}><span aria-hidden="true">←</span> All writing</a><div class="post-meta"><span class:list={['collection', post.data.collection]}>{collectionLabels[post.data.collection]}</span><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time></div><h1>{post.data.title}</h1>{post.data.description && <p class="article-description">{post.data.description}</p>}{post.data.tags.length > 0 && <ul class="tags" aria-label="Topics">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}</header>
    <div class:list={['article-grid', { 'has-toc': toc.length > 1 }]}>
      {toc.length > 1 && <aside class="article-toc"><nav aria-label="On this page"><h2>On this page</h2><ul>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></aside>}
      <div class="prose"><slot /></div>
    </div>
    <footer class="article-footer"><a class="text-link" href={withBase('blog/')}><span aria-hidden="true">←</span> Back to all writing</a></footer>
  </article>
</BaseLayout>
