---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { collectionLabels, formatDate } from '../lib/blog';
import { withBase } from '../lib/urls';
interface Props { post: CollectionEntry<'blog'>; headings: MarkdownHeading[]; }
const { post, headings } = Astro.props;
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description} type="article" published={post.data.published}>
  <article class="article-page">
    <header class="article-header"><a class="text-link back-link" href={withBase('blog/')}><span aria-hidden="true">←</span> All writing</a><div class="post-meta"><span class:list={['collection', post.data.collection]}>{collectionLabels[post.data.collection]}</span><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time></div><h1>{post.data.title}</h1>{post.data.description && <p class="article-description">{post.data.description}</p>}{post.data.tags.length > 0 && <ul class="tags" aria-label="Topics">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}</header>
    <div class:list={['article-grid', { 'has-toc': toc.length > 1 }]}>
      {toc.length > 1 && <aside class="article-toc" aria-label="Article table of contents">
        <nav class="toc-full" aria-label="On this page" tabindex="0"><h2>On this page</h2><ul>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`} data-slug={heading.slug}>{heading.text}</a></li>)}</ul></nav>
        <details class="toc-compact">
          <summary aria-label="Article outline">
            <span class="toc-strokes" aria-hidden="true">{toc.map((heading, i) => <span class:list={['toc-stroke', { 'toc-stroke-short': heading.depth === 3, 'toc-group-start': heading.depth === 2 && i > 0 }]} data-slug={heading.slug} />)}</span>
          </summary>
          <nav class="toc-panel" aria-label="Article outline" tabindex="0"><h2>On this page</h2><ul>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`} data-slug={heading.slug}>{heading.text}</a></li>)}</ul></nav>
        </details>
        <script>
          // Tiny progressive-enhancement scrollspy: highlights the H2/H3 currently being
          // read across the full TOC, the compact rail strokes, and the expanded rail panel.
          // No framework, no dependency; runs only on article pages that render this aside.
          // Astro compiles this to a module script, where document.currentScript is
          // always null — so we locate the (single, page-level) TOC directly instead.
          const tocEl = document.querySelector<HTMLElement>('.article-toc');
          const headings = tocEl
            ? [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')]
              .filter((h) => tocEl.querySelector(`[data-slug="${h.id}"]`))
            : [];

          if (tocEl && headings.length) {
            const links = [...tocEl.querySelectorAll<HTMLElement>('a[data-slug]')];
            const strokes = [...tocEl.querySelectorAll<HTMLElement>('.toc-stroke[data-slug]')];

            const parentOf = new Map<string, string>();
            let currentH2: string | null = null;
            for (const h of headings) {
              if (h.tagName === 'H2') currentH2 = h.id;
              else if (currentH2) parentOf.set(h.id, currentH2);
            }

            let activeSlug: string | null = null;
            const setActive = (slug: string | null) => {
              if (slug === activeSlug) return;
              activeSlug = slug;
              const parentSlug = slug ? parentOf.get(slug) : null;
              for (const el of [...links, ...strokes]) {
                const isActive = el.dataset.slug === slug;
                const isParent = el.dataset.slug === parentSlug;
                el.classList.toggle('active', isActive);
                el.classList.toggle('active-parent', isParent && !isActive);
                if (el.tagName === 'A') {
                  if (isActive) el.setAttribute('aria-current', 'location');
                  else el.removeAttribute('aria-current');
                }
              }
            };

            const OFFSET = 96; // small reading buffer below the top of the viewport
            const computeActive = () => {
              let current = null;
              for (const h of headings) {
                if (h.getBoundingClientRect().top - OFFSET <= 0) current = h;
                else break;
              }
              setActive(current ? current.id : null);
            };

            const spyObserver = new IntersectionObserver(computeActive, {
              rootMargin: `-${OFFSET}px 0px -70% 0px`,
              threshold: 0,
            });
            headings.forEach((h) => spyObserver.observe(h));

            // IntersectionObserver drives most updates cheaply; a passive, rAF-throttled
            // scroll listener is kept only as a redundant correctness net (some engines
            // throttle IO callbacks more aggressively than real scroll events).
            let ticking = false;
            window.addEventListener('scroll', () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => { computeActive(); ticking = false; });
            }, { passive: true });
            computeActive();
          }
        </script>
      </aside>}

      <div class="prose"><slot /></div>
    </div>
    <footer class="article-footer"><a class="text-link" href={withBase('blog/')}><span aria-hidden="true">←</span> Back to all writing</a></footer>
  </article>
  <script>
    // Progressive enhancement for code blocks: the build-time markdown transform
    // renders each Copy button `hidden`, so this reveals them and wires one
    // delegated click handler for the whole article — not one listener per
    // button. Rendered on every article page; if an article has no code
    // blocks, `buttons` is simply empty and this does nothing.
    const buttons = document.querySelectorAll<HTMLButtonElement>('.copy-button');
    if (buttons.length) {
      buttons.forEach((button) => { button.hidden = false; });

      const RESET_MS = 1600;
      const resetTimers = new Map<HTMLButtonElement, number>();
      const resetButton = (button: HTMLButtonElement) => {
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        button.classList.remove('is-copied');
      };

      document.querySelector('.prose')?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-button');
        if (!button) return;
        const codeText = button.closest('.code-block')?.querySelector('pre code')?.textContent ?? '';
        if (!codeText) return;

        navigator.clipboard?.writeText(codeText).then(() => {
          const existing = resetTimers.get(button);
          if (existing) window.clearTimeout(existing);
          button.textContent = 'Copied ✓';
          button.setAttribute('aria-label', 'Copied to clipboard');
          button.classList.add('is-copied');
          resetTimers.set(button, window.setTimeout(() => resetButton(button), RESET_MS));
        }).catch(() => {
          // Clipboard unavailable/denied: leave the button as-is. The code
          // itself is always plain selectable text, so nothing is broken.
        });
      });
    }
  </script>
</BaseLayout>
