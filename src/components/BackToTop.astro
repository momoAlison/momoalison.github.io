<button type="button" class="back-to-top" aria-label="Back to top" hidden>↑</button>
<script>
  // Progressive enhancement, same tiny idiom as the TOC scrollspy: a
  // passive, rAF-throttled scroll listener toggles visibility (hidden near
  // the top, revealed after ~700px — roughly one viewport). Scoped to
  // article-like pages only (ArticleLayout, the Site Guide) since this
  // component is only ever included there, never in BaseLayout directly.
  const button = document.querySelector<HTMLButtonElement>('.back-to-top');
  if (button) {
    const REVEAL_AFTER = 700;
    let ticking = false;
    const updateVisibility = () => {
      ticking = false;
      button.hidden = window.scrollY < REVEAL_AFTER;
    };
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateVisibility);
    }, { passive: true });
    updateVisibility();

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>
